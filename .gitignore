# Secretos (token de Telegram, etc.) — NUNCA subir al repo
.env
agendamelo-generator/.env
agendamelo-generator/.secrets/
/secrets/

# Dependencias
node_modules/
agendamelo-generator/node_modules/

# Imágenes generadas (se regeneran en cada máquina/VPS)
agendamelo-generator/dist/*
!agendamelo-generator/dist/.gitkeep

# CSV vivo: lo maneja el programa en cada máquina (el VPS tiene el suyo).
# La semilla agendamelo_ideas.seed.csv SÍ se versiona.
/agendamelo_ideas.csv
/agendamelo_kits.csv

# Ajustes de operación vivos (nicho activo + estilo de caption): por máquina, fuera de git.
/agendamelo_settings.json

# Pistas de audio locales/licenciadas (se montan en Docker y no se versionan).
/data/music/

# Respaldos del CSV
*.backup*.csv

# Sistema
.DS_Store
