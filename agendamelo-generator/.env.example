# Copia este archivo como .env y rellena tus valores. El .env NO se sube al repo.
TELEGRAM_BOT_TOKEN=pon_aqui_el_token_de_botfather
TELEGRAM_CHAT_ID=tu_chat_id_numerico
AGENDAMELO_ALLOWED_CHATS=tu_chat_id_numerico

# Opcional — Codex (texto del LLM). Por defecto SIEMPRE usa lo más alto: modelo gpt-5.5 + esfuerzo
# xhigh. Solo define estas variables si quieres BAJARLO (p. ej. una tanda comparativa más barata).
# AGENDAMELO_CODEX_MODEL=gpt-5.5
# AGENDAMELO_CODEX_EFFORT controla `model_reasoning_effort`: minimal|low|medium|high|xhigh (default xhigh).
# OJO: xhigh NO garantiza mejor copy; el lever principal es el PROMPT.
# AGENDAMELO_CODEX_EFFORT=medium

# Opcional — datos y operación:
# AGENDAMELO_CSV=/ruta/absoluta/a/agendamelo_ideas.csv            # posts de imagen (Facebook)
# AGENDAMELO_KITS_CSV=/ruta/absoluta/a/agendamelo_kits.csv        # kits de video (TikTok/Reels, /kit)
# AGENDAMELO_SETTINGS=/ruta/absoluta/a/agendamelo_settings.json   # nicho activo + estilo de caption

# Meta Graph API — deja META_AUTO_PUBLISH=false hasta probar `npm run meta:dry-run` y `/publicar`.
# La cuenta de Instagram debe ser profesional y estar conectada a la página de Facebook.
META_GRAPH_VERSION=v26.0
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=
# URL HTTPS pública que apunta al endpoint /media de este contenedor (sin slash final).
PUBLIC_MEDIA_BASE_URL=https://contenido.agendamelo.cl/media
# Opcional: enlace medible que se agrega solo al caption de Facebook.
META_TRACKING_URL=https://agendamelo.cl/?utm_source=facebook&utm_medium=organic&utm_campaign=perfil-gratis-manicuristas
META_AUTO_PUBLISH=false
META_PUBLISH_TIME=20:30
META_TIMEZONE=America/Santiago
