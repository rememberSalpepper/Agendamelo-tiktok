# Copia este archivo como .env y rellena tus valores. El .env NO se sube al repo.
TELEGRAM_BOT_TOKEN=pon_aqui_el_token_de_botfather
TELEGRAM_CHAT_ID=tu_chat_id_numerico
AGENDAMELO_ALLOWED_CHATS=tu_chat_id_numerico

# Opcional — Codex (texto del LLM). Por defecto SIEMPRE usa lo más alto: modelo gpt-5.5 + esfuerzo
# xhigh. Solo define estas variables si quieres BAJARLO (p. ej. una tanda comparativa más barata).
# AGENDAMELO_CODEX_MODEL=gpt-5.5
# AGENDAMELO_CODEX_EFFORT controla `model_reasoning_effort`: minimal|low|medium|high|xhigh (default xhigh).
# OJO: xhigh NO garantiza mejor copy; el lever principal es el PROMPT.
# AGENDAMELO_CODEX_EFFORT=medium

# Opcional — datos y operación:
# AGENDAMELO_CSV=/ruta/absoluta/a/agendamelo_ideas.csv            # posts de imagen (Facebook)
# AGENDAMELO_KITS_CSV=/ruta/absoluta/a/agendamelo_kits.csv        # kits de video (TikTok/Reels, /kit)
# AGENDAMELO_SETTINGS=/ruta/absoluta/a/agendamelo_settings.json   # nicho activo + estilo de caption

# Meta Graph API — deja META_AUTO_PUBLISH=false hasta probar `npm run meta:dry-run` y `/publicar`.
# La cuenta de Instagram debe ser profesional y estar conectada a la página de Facebook.
META_GRAPH_VERSION=v26.0
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=
# URL HTTPS pública que apunta al endpoint /media de este contenedor (sin slash final).
PUBLIC_MEDIA_BASE_URL=https://contenido.agendamelo.cl/media
# Opcional: enlace medible que se agrega solo al caption de Facebook.
META_TRACKING_URL=https://agendamelo.cl/?utm_source=facebook&utm_medium=organic&utm_campaign=perfil-gratis-manicuristas
META_AUTO_PUBLISH=false
# Una pieza por cada franja, todos los días. Compatibilidad: META_PUBLISH_TIME acepta una sola hora.
META_PUBLISH_TIMES=10:00,15:30,20:30
META_TIMEZONE=America/Santiago

# YouTube — OAuth de escritorio con PKCE. Las credenciales se leen desde un JSON 0600
# ignorado por Git. El refresh token se genera una sola vez con `npm run youtube:auth`.
# Local: .secrets/youtube-oauth-client.json
YOUTUBE_OAUTH_CLIENT_FILE=/app/secrets/youtube-oauth-client.json
YOUTUBE_CHANNEL_ACCOUNT=agendamelo.cl@gmail.com
# Local: .secrets/youtube-token.json. En el VPS se configurará una ruta persistente protegida.
YOUTUBE_TOKEN_FILE=/app/secrets/youtube-token.json
# YOUTUBE_OAUTH_PORT=53682
# Mantener private durante las pruebas. Proyectos nuevos/no auditados pueden quedar privados igual.
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_NOTIFY_SUBSCRIBERS=false
YOUTUBE_CATEGORY_ID=22
# El despliegue inicial debe quedar en false hasta pasar check, dry-run y una carga privada manual.
YOUTUBE_AUTO_PUBLISH=false
YOUTUBE_AUTO_RENDER=true
YOUTUBE_PUBLISH_TIME=20:30
YOUTUBE_TIMEZONE=America/Santiago
# Edición del MP4. Las escenas permanecen inmóviles y el fundido pasa por el crema de marca.
YOUTUBE_SCENE_SECONDS=3.4
YOUTUBE_TRANSITION_SECONDS=0.22
YOUTUBE_TRANSITION_HOLD_SECONDS=0.02
YOUTUBE_TRANSITION_SHIFT_PIXELS=18
# Música autorizada + mezcla final para teléfono.
YOUTUBE_MUSIC_VOLUME=0.22
YOUTUBE_DUCKING_LEVEL=0.65
YOUTUBE_INTRO_DUCKING_LEVEL=0.50
YOUTUBE_LOUDNESS_TARGET=-16
YOUTUBE_TRUE_PEAK=-1.5
# Efectos procedurales Lavfi: no requieren archivos externos ni licencias adicionales.
YOUTUBE_SFX_ENABLED=true
YOUTUBE_INTRO_SFX_SECONDS=0.62
YOUTUBE_INTRO_SFX_VOLUME=0.72
YOUTUBE_TRANSITION_SFX_SECONDS=0.20
YOUTUBE_TRANSITION_SFX_VOLUME=0.055
YOUTUBE_OUTRO_SFX_SECONDS=0.72
YOUTUBE_OUTRO_SFX_VOLUME=0.17
# En Docker, ./data/music del VPS queda disponible como /app/music.
YOUTUBE_MUSIC_FILE=/app/music/vibe-check-blue-deer-studio.mp3
YOUTUBE_MUSIC_TITLE=Vibe Check
YOUTUBE_MUSIC_ARTIST=Blue Deer Studio
YOUTUBE_MUSIC_LICENSE=YouTube Audio Library
YOUTUBE_MUSIC_ATTRIBUTION=
